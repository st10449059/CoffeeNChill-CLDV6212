        {
          "name": "Completed Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status endpoint returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Correct order is stored\", function () {\r\n    const order = pm.response.json();\r\n    pm.expect(order.RowKey).to.eql(\r\n        pm.collectionVariables.get(\"statusOrderId\")\r\n    );\r\n    pm.expect(order.PartitionKey).to.eql(\r\n        pm.collectionVariables.get(\"statusOrderDate\")\r\n    );\r\n    pm.expect(order.CustomerName).to.eql(\"Yash Status Test\");\r\n    pm.expect(order.TotalPriceCents).to.eql(2500);\r\n    pm.expect(JSON.parse(order.SelectedItemSKUsJson))\r\n        .to.eql([\"COF-001\"]);\r\n});\r\n\r\npm.test(\"Order reached Collected\", function () {\r\n    pm.expect(pm.response.json().Status).to.eql(\"Collected\");\r\n});\r\n\r\npm.test(\"All lifecycle timestamps are valid and ordered\", function () {\r\n    const order = pm.response.json();\r\n    const fields = [\r\n        \"OrderTimestamp\", \"ReceivedAt\", \"PreparingAt\",\r\n        \"ReadyAt\", \"CollectedAt\"\r\n    ];\r\n    const times = fields.map(function (field) {\r\n        pm.expect(order[field], field).to.be.a(\"string\");\r\n        const time = Date.parse(order[field]);\r\n        pm.expect(Number.isNaN(time), field + \" is valid\").to.eql(false);\r\n        return time;\r\n    });\r\n\r\n    for (let i = 1; i < times.length; i++) {\r\n        pm.expect(times[i], fields[i] + \" follows previous stage\")\r\n            .to.be.at.least(times[i - 1]);\r\n    }\r\n});"
                ]
              }
            }
          ],
