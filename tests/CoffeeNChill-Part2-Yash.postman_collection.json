          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"OrderId\": \"ORD-YASH-STATUS-001\",\r\n  \"CustomerName\": \"Yash Status Test\",\r\n  \"SelectedItemSKUs\": [\"COF-001\"],\r\n  \"TotalPrice\": 25\r\n}",
              "options": {
                "raw": {
