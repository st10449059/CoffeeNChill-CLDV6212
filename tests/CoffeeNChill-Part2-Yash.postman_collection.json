              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order submission returns 202\", function () {\r\n    pm.response.to.have.status(202);\r\n});\r\n\r\npm.test(\"Response contains the submitted order\", function () {\r\n    const sent = JSON.parse(pm.request.body.raw);\r\n    const received = pm.response.json();\r\n    pm.expect(received.OrderId).to.eql(sent.OrderId);\r\n    pm.expect(received.CustomerName).to.eql(sent.CustomerName);\r\n    pm.expect(received.SelectedItemSKUs).to.eql(sent.SelectedItemSKUs);\r\n    pm.expect(received.TotalPrice).to.eql(sent.TotalPrice);\r\n});\r\n\r\npm.test(\"Response includes a valid order timestamp\", function () {\r\n    const received = pm.response.json();\r\n    pm.expect(received.OrderTimestamp).to.be.a(\"string\");\r\n    pm.expect(Number.isNaN(Date.parse(received.OrderTimestamp))).to.eql(false);\r\n});"
